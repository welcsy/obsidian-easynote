{
  "name": "easynote",
  "version": "1.4.0",
  "description": "Obsidian drawing plugin with multi-language UI, Pixel/Image brush modes, pan/hand tool, touch/stylus support, .enote project format, and advanced layer management.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:bdd": "cucumber-js",
    "test:bdd:dry": "cucumber-js --dry-run",
    "test:all": "vitest run && cucumber-js"
  },
  "keywords": [
    "obsidian-plugin",
    "drawing",
    "canvas",
    "handwriting",
    "markdown",
    "wikilink",
    "i18n",
    "multilanguage",
    "touch",
    "stylus",
    "pan",
    "image-layer",
    "text-layer",
    "undo",
    "redo",
    ".enote"
  ],
  "author": "welcsy",
  "license": "MIT",
  "devDependencies": {
    "@cucumber/cucumber": "^12.9.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^16.11.6",
    "@typescript-eslint/eslint-plugin": "5.29.0",
    "@typescript-eslint/parser": "5.29.0",
    "@vitest/coverage-v8": "^4.1.7",
    "builtin-modules": "3.3.0",
    "esbuild": "0.17.3",
    "jsdom": "^29.1.1",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "tsx": "^4.22.3",
    "typescript": "^4.7.4",
    "vitest": "^4.1.7"
  }
}
